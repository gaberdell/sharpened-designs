:root {
    --sharp-metrics-border-radius: 3px;
    --sharp-metrics-tab-contents-margin: 16px;
    --sharp-metrics-window-margin: 2px;
    --sharp-metrics-highlight-width: 3px;
    --sharp-metrics-thin-width: 1px;
    --sharp-metrics-slider-size: 12px;
    --sharp-colors-highlight: rgb(44, 93, 135);
    --sharp-colors-default-text: rgb(196, 196, 196);
    --sharp-colors-default-text-focus: rgb(129, 180, 255);
    --sharp-colors-window-background: rgb(56, 56, 56);
    --sharp-colors-window-border: rgb(36, 36, 36);
    --sharp-colors-window-toolbar: rgb(24, 24, 24);
    --sharp-colors-tab-background: rgb(53, 53, 53);
    --sharp-colors-tab-background-checked: rgb(60, 60, 60);
    --sharp-colors-default-background: rgb(40, 40, 40);
    --sharp-colors-default-border: rgb(35, 35, 35);
    font-size: 10px;
    --sharp-colors-light-background: rgb(65, 65, 65);
}

TemplateContainer {
    flex-grow: 1;
    max-height: 100%;
}

.sharp-backtrace {
    font-size: 7px;
}

.unity-label {
    color: var(--sharp-colors-default-text);
}

.unity-label:focus {
    color: var(--sharp-colors-default-text-focus);
}

.unity-tab__header {
    border-top-left-radius: var(--sharp-metrics-border-radius);
    border-top-right-radius: var(--sharp-metrics-border-radius);
    border-top-width: var(--sharp-metrics-highlight-width);
    border-color: transparent;
    background-color: var(--sharp-colors-tab-background);
    min-height: 16px;
    padding-right: 10px;
    padding-left: 10px;
}

.unity-tab__header:checked {
    border-color: var(--sharp-colors-highlight);
    background-color: var(--sharp-colors-tab-background-checked);
}

.unity-tab-view__content-container {
    flex-grow: 1;
}

.unity-tab__content-container {
    flex-grow: 1;
}

.unity-tab__header-underline {
    height: 0;
}

.unity-tab-view__header-container {
    border-top-left-radius: var(--sharp-metrics-border-radius);
    border-top-right-radius: var(--sharp-metrics-border-radius);
    background-color: var(--sharp-colors-default-background);
    flex-grow: 1;
}

.unity-collection-view__item--alternative-background {
    background-color: rgb(34, 34, 34);
}

.sharp-window {
    border-radius: var(--sharp-metrics-border-radius);
    background-color: var(--sharp-colors-window-background);
}

.sharp-tab-contents {
    padding: var(--sharp-metrics-tab-contents-margin);
    background-color: var(--sharp-colors-window-background);
}

.force-row .unity-composite-field__input {
    flex-direction: row;
}

.force-row .unity-base-field__label {
    flex-shrink: 1;
    flex-grow: 0;
    width: auto;
    height: auto;
    min-width: auto;
    max-width: none;
}

.force-row .unity-composite-field__field {
    flex-grow: 1;
    flex-shrink: 0;
}

.hidden-by-default {
    display: none;
}

.unity-scroller .unity-base-slider__tracker {
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    background-color: rgba(0, 0, 0, 0.502);
}

.unity-scroller .unity-base-slider__dragger {
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    background-color: rgb(238, 238, 238);
}

.unity-scroller__low-button {
    display: none;
}

.unity-scroller__high-button {
    display: none;
}

.unity-scroller--vertical {
    min-width: var(--sharp-metrics-slider-size);
    min-height: auto;
    max-width: var(--sharp-metrics-slider-size);
}

.unity-scroller--vertical .unity-base-slider {
    min-width: var(--sharp-metrics-slider-size);
    min-height: auto;
    max-width: var(--sharp-metrics-slider-size);
}

.unity-scroller--vertical .unity-base-slider__dragger {
    width: 6px;
}

.unity-scroller--horizontal {
    min-height: var(--sharp-metrics-slider-size);
    max-height: var(--sharp-metrics-slider-size);
}

.unity-scroller--horizontal .unity-base-slider {
    min-height: var(--sharp-metrics-slider-size);
    max-height: var(--sharp-metrics-slider-size);
}

.unity-scroller--horizontal .unity-base-slider__dragger {
    height: 6px;
}
