<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/Base/General.uss?fileID=7433441132597879392&amp;guid=c87551fefefdca4468929986027a873e&amp;type=3#General"/>
    <ui:VisualElement data-source-type="Sharp.Tabs.Console.ConsoleTab, Assembly-CSharp" style="flex-grow: 1;">
        <ui:VisualElement style="flex-grow: 0; flex-direction: row; justify-content: flex-start;">
            <ui:VisualElement name="note" style="flex-grow: 0; background-color: rgb(32, 32, 32); flex-direction: row; border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px; padding-right: 4px; padding-left: 4px; margin-right: 2px; margin-left: 2px;">
                <ui:Image source="project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2346436936791262179&amp;guid=406889a69ff6c5841b060e576dc4e2f5&amp;type=3#console.infoicon" style="width: 16px; height: 16px; align-self: center;"/>
                <ui:Label text="Label" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 2px; padding-right: 2px; padding-bottom: 2px; padding-left: 2px; align-self: center;">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="note_count" binding-mode="ToTarget"/>
                    </Bindings>
                </ui:Label>
                <ui:Toggle label="" name="Note-Toggle" style="width: 12px; height: 12px; align-self: center;">
                    <Bindings>
                        <ui:DataBinding property="value" data-source-path="show_notes" binding-mode="TwoWay"/>
                    </Bindings>
                </ui:Toggle>
            </ui:VisualElement>
            <ui:VisualElement name="warning" style="flex-grow: 0; background-color: rgb(32, 32, 32); flex-direction: row; border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px; padding-right: 4px; padding-left: 4px; margin-right: 2px; margin-left: 2px;">
                <ui:Image source="project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=8228938214290033325&amp;guid=406889a69ff6c5841b060e576dc4e2f5&amp;type=3#console.warnicon" style="width: 16px; height: 16px; align-self: center;"/>
                <ui:Label text="Label" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 2px; padding-right: 2px; padding-bottom: 2px; padding-left: 2px; align-self: center;">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="warning_count" binding-mode="ToTarget"/>
                    </Bindings>
                </ui:Label>
                <ui:Toggle label="" name="Warning-Toggle" style="width: 12px; height: 12px; align-self: center;">
                    <Bindings>
                        <ui:DataBinding property="value" data-source-path="show_warnings" binding-mode="TwoWay"/>
                    </Bindings>
                </ui:Toggle>
            </ui:VisualElement>
            <ui:VisualElement name="error" style="flex-grow: 0; background-color: rgb(32, 32, 32); flex-direction: row; border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px; padding-right: 4px; padding-left: 4px; margin-right: 2px; margin-left: 2px;">
                <ui:Image source="project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=4456449167576933126&amp;guid=406889a69ff6c5841b060e576dc4e2f5&amp;type=3#console.erroricon" style="width: 16px; height: 16px; align-self: center;"/>
                <ui:Label text="Label" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 2px; padding-right: 2px; padding-bottom: 2px; padding-left: 2px; align-self: center;">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="error_count" binding-mode="ToTarget"/>
                    </Bindings>
                </ui:Label>
                <ui:Toggle label="" name="Error-Toggle" style="width: 12px; height: 12px; align-self: center;">
                    <Bindings>
                        <ui:DataBinding property="value" data-source-path="show_errors" binding-mode="TwoWay"/>
                    </Bindings>
                </ui:Toggle>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:ListView name="logs" virtualization-method="DynamicHeight" show-bound-collection-size="true" allow-add="false" allow-remove="false" selection-type="None" show-alternating-row-backgrounds="All" show-border="true" horizontal-scrolling="true" focusable="false" style="flex-grow: 0; flex-shrink: 1; max-height: 100%;"/>
    </ui:VisualElement>
</ui:UXML>
